# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://sitescope:sitescope@localhost:5433/sitescope"

# Auth.js — generate with: npx auth secret  (or any 32+ char random string)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Optional: Google OAuth (leave blank to use email/password only)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Claude: optional. Without a key, AEO, GEO, features, UI/UX ideas, grammar filtering and the
# screenshot review are skipped; everything else still runs. Usage is billed to this key.
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-5-5"

# API / web wiring
API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Base URL browsers use to load screenshots from the API (defaults to http://localhost:API_PORT)
API_PUBLIC_URL=""
WEB_ORIGIN="http://localhost:3000"

# Audit behaviour
AUDIT_RATE_LIMIT_PER_HOUR=5
AUDIT_MOCK_MODE=false
LIGHTHOUSE_CACHE_TTL_MS=900000
LANGUAGETOOL_URL="https://api.languagetool.org/v2/check"
# Optional: path to Chrome if chrome-launcher can't find it
CHROME_PATH=""
