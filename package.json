{
  "name": "sitescope",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @sitescope/db migrate",
    "db:generate": "pnpm --filter @sitescope/db generate"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
